{
  "name": "@notification-hub/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "信息整合 web 服务：接收通知原文，调用 DeepSeek 生成信息卡并落库",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.4",
    "@notification-hub/shared": "workspace:*",
    "fastify": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
